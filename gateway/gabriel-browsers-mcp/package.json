{
  "name": "gabriel-browsers-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "bin": {
    "gabriel-browsers-mcp": "./dist/src/index.js",
    "gabriel-browserctl": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "generate:tools": "tsx scripts/generate-tool-cache.ts",
    "postinstall": "patch-package",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.76"
  },
  "devDependencies": {
    "@types/node": "24.0.4",
    "patch-package": "^8.0.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
