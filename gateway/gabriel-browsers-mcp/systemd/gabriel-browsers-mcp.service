[Unit]
Description=Gabriel Browsers Supervisor
After=network.target graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.codex/gabriel-browsers-mcp.env
WorkingDirectory=%h/.local/share/gabriel-browsers-mcp/current
ExecStart=%h/.local/share/gabriel-browsers-mcp/current/scripts/start-gateway.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
