{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser CDP Custom Linux",
  "version": "0.1.0",
  "identifier": "com.gabrielalonso.browser-cdp-custom-linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Browser CDP Custom Linux",
        "width": 456,
        "height": 520,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-template.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "HTML",
        "mimeType": "text/html",
        "role": "Viewer"
      },
      {
        "ext": ["http"],
        "name": "HTTP URL",
        "mimeType": "x-scheme-handler/http",
        "role": "Viewer"
      },
      {
        "ext": ["https"],
        "name": "HTTPS URL",
        "mimeType": "x-scheme-handler/https",
        "role": "Viewer"
      }
    ],
    "shortDescription": "Linux CDP profile launcher",
    "longDescription": "Launcher and default-browser router for persistent Chrome CDP profiles on Linux."
  }
}
